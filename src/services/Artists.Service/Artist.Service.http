@hostname = localhost
@port = 8080
@gatewayUrl = http://{{hostname}}:{{port}}
@realm = music-catalog

### 

GET {{gatewayUrl}}/auth/realms/{{realm}}/.well-known/openid-configuration

### 

POST {{gatewayUrl}}/auth/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=api-client&
username=admin&
password=admin&
grant_type=password

