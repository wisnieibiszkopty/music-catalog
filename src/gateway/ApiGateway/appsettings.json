{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set",
            "For": "Append",
            "Proto": "Append",
            "Host": "Append",
            "HeaderPrefix": "X-Forwarded-"
          }
        ]
      },
      "artist-route": {
        "ClusterId": "artist-cluster",
        "Match": {
          "Path": "/api/artists/{**catch-all}"
        }
      },
      "frontend-route": {
        "ClusterId": "frontend-cluster",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://keycloak:8080" }
        }
      },
      "artist-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://artist-service:8080" }
        }
      },
      "frontend-cluster": {
        "Destinations": { "dest1": { "Address": "http://web-app:80" } }
      }
    }
  }
}
