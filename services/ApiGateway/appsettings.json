{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:8080"
  ],
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "rabbit-mgmt-route": {
        "ClusterId": "rabbit-mgmt-cluster",
        "Match": {
          "Path": "/rabbit/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/rabbit" }
        ]
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set",
            "For": "Append",
            "Proto": "Append",
            "Host": "Append",
            "HeaderPrefix": "X-Forwarded-"
          }
        ]
      },
      "artist-route": {
        "ClusterId": "artist-cluster",
        "Match": {
          "Path": "/api/artists/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "scraper-route": {
        "ClusterId": "scraper-cluster",
        "AuthorizationPolicy": "AuthPolicy",
        "Match": {
          "Path": "/api/scraper/{**catch-all}"
        }
      },
      "notification-router": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "frontend-route": {
        "ClusterId": "frontend-cluster",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "rabbit-mgmt-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://rabbitmq:15672"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://keycloak:8080" }
        }
      },
      "artist-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://artist-service:8080" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://catalog-service:8080" }
        }
      },
      "scraper-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://orchestrator-service:8080" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://notification-service:8080" }
        }
      },
      "frontend-cluster": {
        "Destinations": { "dest1": { "Address": "http://web-app:80" } }
      }
    }
  }
}
